meta {
  name: Search customer
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/customers/search?firstName={{testFirstName}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("customer search succeeds", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });

  test("search finds the test customer", function () {
    const customerId = String(bru.getVar("customerId"));
    const match = res.getBody().find((customer) => String(customer.id) === customerId);
    expect(match).to.exist;
    expect(match.firstName).to.equal(bru.getVar("testFirstName"));
  });
}
